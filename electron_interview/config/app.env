# Non-secret defaults bundled into the installer as resources/.env (electron-builder.yml).
# Generated from the development .env with every *_API_KEY / *_TOKEN / *_SECRET line removed,
# so no credentials ship in the installer. Unlike the dev .env, STT_DEBUG is off (it writes interview text
# to the log files). The keyword STT_PROMPT is kept: it measured better on a real recording (see below).
# Per-user settings and API keys go in %APPDATA%<app>.env (macOS: ~/Library/Application Support/<app>/.env);
# values there override these key by key (see loadDotEnv in src/main/index.ts).

WHISPER_BINARY_PATH=
WHISPER_MODEL_PATH=
SILENCE_TIMEOUT_MS=750                # silence (ms) after an interim transcript before submitting to LLM
VAD_HANGOVER_MS=350                   # silence (ms) that ends a speech segment; also the trailing pad whisper sees
CONTINUATION_GRACE_MS=900             # after end-of-speech, how long a new segment still counts as the SAME question.
                                      # Must exceed your natural mid-sentence pause or half-questions get answered:
                                      # measured on a real recording, intra-question pauses hit 736ms while gaps
                                      # between questions never dropped below 1792ms. Whisper runs inside this window.
VAD_PREROLL_MS=300                    # audio (ms) kept from before the speech onset, so soft lead-ins ("What is...") are not clipped
# VAD_PAD_FRAMES=10                   # DEPRECATED: counted capture chunks, not time, so its real value depended on the sound card
                                      # (853ms @48kHz, 2.5s @16kHz-native) despite claiming 320ms. Read as frames*32ms if still set.
VAD_MAX_SEGMENT_MS=8000               # max continuous speech segment length before a forced split; clamped to 8100 so a segment
                                      # never exceeds whisper's 256KB limit and get split into serialized inference calls
# AUDIO_MIC_FALLBACK=0                # if system audio capture fails: 1 = record via mic, 0 = show a warning and stay idle.
                                      # Unset = off on Windows, on elsewhere (macOS has no loopback capture in Electron 31).
# STT_DEBUG=true                      # logs every interim/final transcript decision -- interview text in the log files; dev only
STT_PROMPT=The following is a technical interview regarding software engineering and AI. Keywords: Node.js, Gen AI, AI agent, JavaScript, TypeScript, Python, React.                           # initial prompt guiding whisper (default: interview Q&A with technical keywords)
                                      # Restored 2026-10-24: on the user's own recording the keyword list fixes "Gen AI" (default prompt: "Gen.A.I.E"),
                                      # beating the synthetic-voice result that removed it. Re-test with bench/audio/local before changing.


# LLM generation: pick Groq or local Ollama in the UI. When Groq is selected and fails
# before streaming, the answer falls back to Ollama automatically.
# Single place to swap the Groq model. Default: qwen/qwen3.8-27b (free tier ~8K tokens/min: rate-limited questions go to Ollama).
GROQ_MODEL=qwen/qwen3.8-27b
